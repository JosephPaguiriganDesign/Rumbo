{
  "name": "rumbo-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rumbo Design System Starter: travel dispatch pinned to a tactics board.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "contrast": "node scripts/contrast.mjs",
    "storybook": "npm run tokens && npm run docs && storybook dev -p 6006",
    "build-storybook": "npm run tokens && npm run docs && storybook build -o storybook-static",
    "serve": "npx http-server storybook-static -p 6007 -s",
    "test:stories": "node scripts/verify-stories.mjs",
    "figma-assets": "node scripts/figma-assets.mjs",
    "docs": "node scripts/contrast.mjs && node scripts/build-docs.mjs",
    "test:interaction": "node scripts/interaction-test.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/html-vite": "^10.6.1",
    "axe-core": "^4.13.0",
    "http-server": "^14.1.1",
    "playwright-core": "^1.63.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "vite": "^8.3.1"
  }
}